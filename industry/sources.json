        "parseMode": "html",
        "itemSelector": "ul.tag-con > li.clearfix",
        "linkSelector": "a.tag-caption",
        "titleSelector": "a.tag-caption",
        "publishedAtSelector": "span.tag-time-con",
        "denyUrlPrefixes": [
          "https://www.hrtechchina.com/category/",
          "https://www.hrtechchina.com/tag/",
          "https://www.hrtechchina.com/page/"
        ],
